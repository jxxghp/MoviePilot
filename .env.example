# API 服务器配置
API_HOST=0.0.0.0
API_PORT=5000
DEBUG=True
SECRET_KEY=your-secret-key-here

# LLM 配置
# 可选值: openai, azure, anthropic, none
LLM_PROVIDER=none
LLM_API_KEY=
LLM_MODEL=gpt-4
LLM_BASE_URL=

# Agent 配置
AGENT_MAX_ITERATIONS=5
AGENT_TIMEOUT=30

# 数据库配置（未来扩展）
DATABASE_URL=

# 下载配置
DOWNLOAD_PATH=./downloads
MAX_CONCURRENT_DOWNLOADS=3

# 日志配置
LOG_LEVEL=INFO
LOG_FILE=movie_agent.log
